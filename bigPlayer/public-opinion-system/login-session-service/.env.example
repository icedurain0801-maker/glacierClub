LOGIN_SESSION_HOST=127.0.0.1
LOGIN_SESSION_PORT=4310
LOGIN_SESSION_INTERNAL_TOKEN=replace-with-a-long-random-secret
LOGIN_SESSION_TTL_MS=3600000
LOGIN_CHALLENGE_TTL_MS=300000
LOGIN_RESULT_EXCHANGE_TTL_MS=30000

# Production adapters are fail-closed in phase one. These flags remain disabled.
DOUYIN_LOGIN_ADAPTER_ENABLED=false
XIAOHONGSHU_LOGIN_ADAPTER_ENABLED=false
BIGPLAYER_H5_LOGIN_ADAPTER_ENABLED=false

# Main server internal resolver (loopback by default)
PUBLIC_OPINION_SERVER_URL=http://127.0.0.1:4320
LOGIN_SESSION_HEADLESS=true
LOGIN_AUTOMATION_TIMEOUT_MS=30000
