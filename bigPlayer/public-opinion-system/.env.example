PORT=4320
# MySQL / MariaDB —— 二选一：整串 DATABASE_URL 优先，否则用下面分项
# DATABASE_URL=mysql://root:@127.0.0.1:3306/public_opinion
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=public_opinion
DB_POOL_SIZE=10
# 允许多个管理端 Origin，用英文逗号分隔；OPTIONS 与实际响应使用同一白名单。
PUBLIC_OPINION_CORS_ORIGIN=http://127.0.0.1:8123,http://localhost:8093
# OAuth 完成后只回跳到该固定后台地址，不接受请求参数覆盖。
PUBLIC_OPINION_ADMIN_RETURN_URL=http://127.0.0.1:8123/admin/PublicOpinion/sources.html

# Worker —— 默认 60s 扫一次到期源
WORKER_INTERVAL_MS=60000
WORKER_CONCURRENCY=2

# BigPlayer H5 JSON API. Each source stores one site URL and an encrypted api_token credential.
# club.q1.com sources discover the authorized board and read the merged post feed. The full site URL
# must retain env/gameId/gameVersion/lang query parameters. No verified comment endpoint is assumed.
# Historical provider sources with postsApiUrl + commentsApiUrl remain readable for compatibility.
BIGPLAYER_H5_ENABLED=false
BIGPLAYER_H5_API_BASE_URL=https://club.q1.com
# Exact hosts only; deceptive subdomains and localhost remain rejected.
BIGPLAYER_H5_ALLOWED_HOSTS=club.q1.com
BIGPLAYER_H5_POSTS_PATH=/internal/opinion/posts
BIGPLAYER_H5_COMMENTS_PATH=/internal/opinion/posts/:postId/comments
BIGPLAYER_H5_TIMEOUT_MS=15000
# Legacy HTML collect compatibility only; new list APIs never read these env credentials.
BIGPLAYER_H5_BASE_URL=
BIGPLAYER_H5_START_PATHS=/
BIGPLAYER_H5_AUTH_COOKIE=
BIGPLAYER_H5_BEARER_TOKEN=
BIGPLAYER_H5_MAX_DEPTH=5
BIGPLAYER_H5_MAX_PAGES=100
BIGPLAYER_H5_DELAY_MS=500

# External platform connectors stay disabled until official API/auth is configured.
TAPTAP_ENABLED=false
TAPTAP_API_BASE_URL=
TAPTAP_API_TOKEN=
BILIBILI_ENABLED=false
BILIBILI_API_BASE_URL=
BILIBILI_API_TOKEN=
# Douyin official OpenAPI PoC; account access tokens are stored in po_credentials, never here.
DOUYIN_ENABLED=false
DOUYIN_API_BASE_URL=https://open.douyin.com
DOUYIN_VIDEO_LIST_PATH=/video/list/
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=http://localhost:4320/api/public-opinion/oauth/douyin/callback
DOUYIN_OAUTH_AUTHORIZE_URL=https://open.douyin.com/platform/oauth/connect/
DOUYIN_OAUTH_TOKEN_URL=https://open.douyin.com/oauth/access_token/
DOUYIN_OAUTH_STATE_TTL_MS=600000
DOUYIN_COMMENTS_ENABLED=false
# 第一阶段只开放 Mock 登录状态机；真实直登适配器未配置时必须 fail-closed。
DOUYIN_DIRECT_LOGIN_ENABLED=false
XIAOHONGSHU_DIRECT_LOGIN_ENABLED=false
LOGIN_SESSION_SERVICE_URL=http://127.0.0.1:4310
LOGIN_SESSION_INTERNAL_TOKEN=
LOGIN_SESSION_MOCK_ENABLED=false
WEIBO_ENABLED=false
TIEBA_ENABLED=false

# Company AI analysis service (第三方 OpenAI 兼容 /chat/completions)
# 所有新增/正文变化内容先做 light；关键词、中高风险、强负面、低置信度再升级 deep。
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_URL=
AI_ANALYSIS_TOKEN=
# openai-chat-completions（默认）或 anthropic-messages；Anthropic 模式会请求 ${AI_ANALYSIS_URL}/messages。
AI_ANALYSIS_API=openai-chat-completions
# 旧单模型兼容项；生产建议显式配置 light/deep。
AI_ANALYSIS_MODEL=
AI_ANALYSIS_VERSION=sentiment-v1
AI_ANALYSIS_LIGHT_MODEL=
AI_ANALYSIS_LIGHT_VERSION=sentiment-v1
AI_ANALYSIS_LIGHT_BATCH_SIZE=20
AI_ANALYSIS_LIGHT_MAX_CHARS=300
AI_ANALYSIS_LIGHT_MAX_OUTPUT_TOKENS=800
AI_ANALYSIS_LIGHT_DAILY_CALL_LIMIT=500
AI_ANALYSIS_DEEP_MODEL=
AI_ANALYSIS_DEEP_VERSION=sentiment-v1
AI_ANALYSIS_DEEP_BATCH_SIZE=10
AI_ANALYSIS_DEEP_MAX_CHARS=1200
AI_ANALYSIS_DEEP_MAX_OUTPUT_TOKENS=1600
AI_ANALYSIS_DEEP_DAILY_CALL_LIMIT=100
AI_ANALYSIS_DEEP_NEGATIVE_THRESHOLD=0.7
AI_ANALYSIS_DEEP_LOW_CONFIDENCE_THRESHOLD=0.55
AI_ANALYSIS_JOB_BATCH_SIZE=100
AI_ANALYSIS_JOB_MAX_ATTEMPTS=3
AI_ANALYSIS_JOB_RETRY_BASE_SECONDS=60
AI_ANALYSIS_BACKFILL_BATCH_SIZE=100
AI_ANALYSIS_MAX_RETRIES=3          # 5xx/网络错误指数退避重试上限（4xx 不重试）
AI_ANALYSIS_TIMEOUT_MS=30000       # 单次请求超时
# 每日限定任务：分析前一北京时间自然日，超时后以非零退出，不会转去消费历史积压。
DAILY_RUN_TIMEOUT_MS=3600000      # 每次 daily 采集+分析的总墙钟上限（1 小时）
DAILY_COMMENT_PARENT_LIMIT=100     # 每次最多刷新多少个历史父帖评论树
DAILY_COMMENT_PAGE_BUDGET=3        # 每个父帖每次最多抓取多少页评论/回复
DAILY_ANALYSIS_MAX_BATCHES=20      # 每轮补建分析任务最多 20 批，下一次继续 checkpoint
DAILY_ANALYSIS_TIMEOUT_MS=7200000
DAILY_ANALYSIS_IDLE_MS=1000
# Daily fetch concurrency is fixed at DB commit concurrency; keep these at 4 unless the DB contract changes.
DAILY_FEED_FETCH_CONCURRENCY=4
DAILY_COMMENT_FETCH_CONCURRENCY=4
DAILY_REPLY_FETCH_CONCURRENCY=4
# 旧成本护栏兼容项；profile 未配置时作为回退。
AI_ANALYSIS_BATCH_SIZE=20
AI_ANALYSIS_MAX_CHARS=300
AI_ANALYSIS_MAX_OUTPUT_TOKENS=800
AI_ANALYSIS_DAILY_CALL_LIMIT=500

# DingTalk alert adapter
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 告警引擎
PO_ALERT_COOLDOWN_SECONDS=900      # 同游戏+同类型告警冷却期，冷却内复用不重复轰炸

# 凭据加密（安全红线）
# 后台「采集源授权」填写的 Cookie/token 用 AES-256-GCM 加密后落 po_credentials.secret_cipher，
# 明文只在服务端内存出现，永不落库、永不日志、永不回显。
# 必填：32 字节，hex(64 位) 或 base64。缺失/非法时凭据接口 fail-closed 拒绝写入（不降级明文）。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENC_KEY=

# 社区主数据（由外部后台只读提供；URL 必须为 HTTPS，Token 仅服务端持有）
COMMUNITY_PROVIDER_URL=
COMMUNITY_PROVIDER_TOKEN=
COMMUNITY_PROVIDER_TIMEOUT_MS=5000
COMMUNITY_PROVIDER_CACHE_TTL_MS=60000
