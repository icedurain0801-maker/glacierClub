 `po_sync_runs_queue_idx` (`status`,`scheduled_at`,`next_retry_at`,`created_at`), KEY `po_sync_runs_source_status_lease_idx` (`source_id`,`status`,`lease_until`), CONSTRAINT `po_sync_runs_account_fk` FOREIGN KEY (`account_id`) REFERENCES `po_accounts` (`id`) ON DELETE CASCADE, CONSTRAINT `po_sync_runs_source_fk` FOREIGN KEY (`source_id`) REFERENCES `po_sources` (`id`), CONSTRAINT `po_sync_runs_trigger_slot_chk` CHECK (`trigger_type` in ('legacy','manual') and `scheduled_at` is null or `trigger_type` in ('scheduled','scheduled_catchup') and `scheduled_at` is not null) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
