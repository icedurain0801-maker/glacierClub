# ===== 腾讯云云数据库 MySQL 配置 =====
# 控制台 → 云数据库 MySQL → 实例详情 获取以下信息
# 外网地址示例：bj-cdb-xxxx.sql.tencentcdb.com，端口通常非 3306
# 同 VPC 的 CVM 部署时建议用「内网地址」，更快且免 SSL
DB_HOST=你的实例地址.sql.tencentcdb.com
DB_PORT=你的实例端口
DB_NAME=wc2026_betting
DB_USER=你的数据库账号
DB_PASSWORD=你的数据库密码
# 用外网地址连接时设为 true（开启 SSL）；用内网地址可设为 false
DB_SSL=true

# 改成一段随机字符串，不要用默认值
JWT_SECRET=change_me_to_random_string
JWT_EXPIRES_IN=7d

PORT=3000

# 首次启动自动创建管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
