DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_companion
DB_USER=root
DB_PASSWORD=
DB_SSL=false

JWT_SECRET=change_me_to_random_string
JWT_EXPIRES_IN=7d

PORT=3100

# 首次迁移创建的超管账号
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=Admin123!

# —— 知识库(KB)配置 ——
# embedding 云 API：OpenAI 兼容格式(请求 input 为字符串数组，响应 data[].embedding)。
# 也兼容通义 DashScope 原生响应作回退。换厂商一般只改下面三项。
EMBEDDING_API_URL=https://chat-test.q1.com/v1/embeddings
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 分片上传临时目录（相对 server 目录）
KB_UPLOAD_TMP_DIR=uploads/tmp

# 知识库内嵌图片存储目录（相对 server 目录，长期保留不清理）
KB_IMAGES_DIR=uploads/kb-images

# worker 轮询间隔(ms)
KB_WORKER_INTERVAL=2000

# —— LLM 对话配置(OpenAI 兼容 chat/completions) ——
LLM_API_URL=https://chat-test.q1.com/v1/chat/completions
LLM_API_KEY=your_llm_key_here
LLM_MODEL=claude-sonnet-4-6
